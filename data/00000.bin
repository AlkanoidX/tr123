        "visuals.enable_gun_glow": {
            "title": "\\{review}Waffenleuchten",
            "description": "\\{review}FÃ¼gt um MÃ¼ndungsfeuer und Fackelblitze einen Glanzeffekt hinzu, wie in der PS1-Version von TR2.",
        },
        "visuals.enable_gun_lighting": {
            "title": "Dynamisches Licht fÃ¼r Waffen",
            "description": "Aktiviert die verwendung von dynamischer Beleuchtung fÃ¼r SchÃ¼sse und Explosionen.",
        },
        "visuals.enable_photo_mode_collision": {
            "title": "\\{review}Kollision im Fotomodus",
            "description": "\\{review}Zwingt die Kamera dazu, der Geometrie zu folgen, wenn sie sich im Fotomodus durch ein Level bewegt. Wenn diese Option deaktiviert ist, kann sich die Kamera frei durch WÃ¤nde, Decken und BÃ¶den bewegen.",
        },
        "visuals.enable_poison_vision": {
            "title": "\\{review}Giftvision",
            "description": "\\{review}Verzerrt die Sicht, wÃ¤hrend Lara vergiftet ist. Deaktivieren, wenn Sie zu Reisekrankheit neigen.",
        },
        "visuals.enable_ps1_crystals": {
            "title": "PS1-Kristall-Farbton",
            "description": "Der Speicherkristall bekommt einen lila Farbton, Ã¤hnlich wie bei der PS1-Variante.",
        },
        "visuals.enable_ps1_rain": {
            "title": "\\{review}PS1-Regentropfen",
            "description": "\\{review}Regentropfen werden der Szene hinzugefÃ¼gt, statt mit ihr vermischt zu werden, und wirken dadurch hell wie auf der PS1.",
        },
        "visuals.enable_rain_splashes": {
            "title": "\\{review}Regenspritzer",
            "description": "\\{review}Regentropfen spritzen dort auf, wo sie auf den Boden oder das Wasser treffen.",
        },
        "visuals.enable_reflections": {
            "title": "Reflektionen",
            "description": "Aktiviert Reflektionen auf bestimmten Objekten.",
        },
        "visuals.enable_shotgun_flash": {
            "title": "Schrotflinten-MÃ¼ndungsfeuer",
            "description": "Zeigt MÃ¼ndungsfeuer an, wenn man mit der Schrotflinte schieÃŸt, wie bei anderen Waffen.",
        },
        "visuals.enable_skybox": {
            "title": "Skyboxes",
            "description": "Aktiviert die Skybox in unterstÃ¼tzten Leveln.",
        },
        "visuals.enable_spherical_fog": {
            "title": "\\{review}KugelfÃ¶rmiger Nebel",
            "description": "\\{review}LÃ¤sst den Nebel vom Abstand zur Kamera abhÃ¤ngen, sodass ein Drehen der Kamera die Sichtweite nicht Ã¤ndert. Wenn deaktiviert, hÃ¤ngt der Nebel wie in den Originalspielen von der Tiefe entlang der Blickrichtung ab, und an den BildrÃ¤ndern sieht man weiter als in der Mitte.",
        },
        "visuals.enable_static_lighting": {
            "title": "\\{review}Beleuchtung statischer Meshes",
            "description": "\\{review}LÃ¤sst Flammen und andere dynamische Lichter statische Meshes beleuchten. Das originale TR4 beleuchtet nur die Raumgeometrie.",
        },
        "visuals.enable_weather": {
            "title": "\\{review}Wetter",
            "description": "\\{review}Aktiviert die Darstellung von Wettereffekten in unterstÃ¼tzten Levels.",
        },
        "visuals.fix_animated_sprites": {
            "title": "Fix: Sprite-Animationen",
            "description": "\\{review}Behebt die ursprÃ¼nglichen Unterwasser-Pflanzen-Sprites, sodass sie in Wasserbereichen richtig animiert werden.",
        },
        "visuals.fix_item_rots": {
            "title": "\\{review}Fix: Objektplatzierung",
            "description": "\\{review}Behebt mehrere Probleme aus den Originalspielen, die durch falsch platzierte oder ausgerichtete Objekte verursacht werden.",
        },
        "visuals.fix_projectile_brightness": {
            "title": "\\{review}Projektilhelligkeit korrigieren",
            "description": "\\{review}Behebt, dass Projektile wie Messer, Harpunen und Granaten in voller Helligkeit gezeichnet werden, statt vom umgebenden Raum beleuchtet zu werden.",
        },
        "visuals.fix_smoke_emitters": {
            "title": "\\{review}Rauchemitter korrigieren",
            "description": "\\{review}Behebt Rauchemitter, die eigentlich schwarz dargestellt werden sollten, aber weiÃŸ erscheinen.",
        },
        "visuals.fix_texture_issues": {
            "title": "Fix: Textur-Fehler",
            "description": "Fixt originale Fehler mit fehlenden oder inkorrekten Texturen/Meshes.",
        },
        "visuals.fog_color": {
            "title": "\\{review}Nebel Farbe",
            "description": "\\{review}Farbe des Nebels.",
        },
        "visuals.fog_end": {
            "title": "Ende des Nebels",
            "description": "\\{review}Stellt die Distanz in Kacheln ein, in der der Nebel alles vÃ¶llig verhÃ¼llt. Im originalen TR2 und TR3 ist das bei 20 Kacheln der Fall. Ein Level kann einen eigenen Wert mitbringen, der dann stattdessen gilt.",
        },
        "visuals.fog_start": {
            "title": "Beginn des Nebels",
            "description": "\\{review}Stellt die Distanz in Kacheln ein, in der der Nebel zu erscheinen beginnt. Im originalen TR2 und TR3 beginnt er bei 12 Kacheln. Ein Level kann einen eigenen Wert mitbringen, der dann stattdessen gilt.",
        },
        "visuals.fog_transparency": {
            "title": "\\{review}Nebel Transparenz",
            "description": "Bestimmt ob die Ãœberlagerung entfernter Geometrie mit 100% transparenten FlÃ¤chen aktiviert werden soll.",
        },
        "visuals.fov": {
            "title": "\\{review}Sichtfeld",
            "description": "\\{review}Blickwinkel in Grad. GrÃ¶ÃŸere Werte erweitern das Sichtfeld, kleinere verengen es.",
        },
        "visuals.game_brightness": {
            "title": "Helligkeit",
            "description": "Ã„ndert die Helligkeit des Spiels.",
        },
        "visuals.gamma": {
            "title": "\\{review}Gamma",
            "description": "\\{review}Passt die Gammakurve an. HÃ¶here Werte bedeuten hellere Beleuchtung. Der Wert 2,5 entspricht den Standardfarben.",
        },
        "visuals.golden_lara": {
            "title": "\\{review}Goldene Lara",
            "description": "\\{review}Verwandelt Lara in Gold, unabhÃ¤ngig vom getragenen Outfit, so wie es die Hand des Midas tut.",
        },
        "visuals.lara_outfit": {
            "title": "\\{review}Laras Outfit",
            "description": "\\{review}Ã„ndert Laras Aussehen. Bei Auswahl von Standard werden die regulÃ¤ren Outfit-Wechsel zwischen den Levels beibehalten, andernfalls bleibt das gewÃ¤hlte Outfit aktiv, bis es manuell geÃ¤ndert wird.",
        },
        "visuals.level_start_transition": {
            "description": "\\{review}Wie ein Level erscheint, wenn es beginnt oder ein Spielstand geladen wird. Ãœberblenden lÃ¤sst den Ladebildschirm in das Level Ã¼bergehen. Ãœber Schwarz blendet den Ladebildschirm nach Schwarz ab und das Level aus Schwarz auf, wie im originalen TR4. Ohne Ladebildschirm blenden beide das Level aus Schwarz auf. Deaktiviert zeigt das Level sofort.",
            "title": "\\{review}Ãœbergang beim Levelstart",
            "values": {
                "black": "\\{review}Ãœber Schwarz",
                "cross-fade": "\\{review}Ãœberblenden",
                "disabled": "\\{review}Deaktiviert",
            }
        },
        "visuals.logo_locale": {
            "description": "\\{review}Welches Logo der Titelbildschirm zeigt. Das Original bringt fÃ¼r jede Sprache, in der es erschienen ist, ein eigenes mit.",
            "title": "\\{review}Titel-Logo",
            "values": {
                "de": "\\{review}Deutsch",
                "en-gb": "\\{review}Englisch (UK)",
                "en-us": "\\{review}Englisch (USA)",
                "fr": "\\{review}FranzÃ¶sisch",
            }
        },
        "visuals.shadow_type": {
            "title": "\\{review}Schattenform",
            "description": "\\{review}WÃ¤hlt aus, wie die Schatten von EntitÃ¤ten dargestellt werden.\n\n- Achteck: alte TR1- und TR2-Schatten\n- Kreis: runde Schatten\n- Sprite: TR3 texturbasierte Schatten",
        },
        "visuals.sunglasses_mode": {
            "title": "\\{review}Laras Sonnenbrille",
            "description": "\\{review}Ã„ndert den Stil von Laras Sonnenbrille. Hinweis: Die GlÃ¤ser sind reflektierend, wenn die entsprechende Option aktiviert ist.\n\n- Aus: Lara trÃ¤gt keine Sonnenbrille.\n- Undurchsichtig: Laras Sonnenbrille hat undurchsichtige GlÃ¤ser.\n- Transparent: Laras Sonnenbrille hat halbtransparente GlÃ¤ser.",
        },
        "visuals.sunglasses_reflective": {
            "title": "\\{review}Reflektierende Sonnenbrille",
            "description": "\\{review}Aktiviert Reflexionen auf den GlÃ¤sern von Laras Sonnenbrille. Reflexionen mÃ¼ssen ebenfalls aktiviert sein.",
        },
        "visuals.ui_brightness": {
            "title": "UI-Helligkeit",
            "description": "Ã„ndert die Helligkeit der BenutzeroberflÃ¤che.",
        },
        "visuals.water_color": {
            "title": "Wasser-Farbe",
            "description": "Farbe des Wassers.",
        },
        "visuals.water_color_mode": {
            "description": "\\{review}Welcher Unterwasser-Farbton verwendet wird. Solange eine Vorgabe gewÃ¤hlt ist, hÃ¤lt sie die Wasserfarbe unten fest; Benutzerdefiniert Ã¼berlÃ¤sst diese Farbe Ihnen.",
            "title": "\\{review}Wasserfarbvorgabe",
            "values": {
                "custom": "\\{review}Benutzerdefiniert",
                "dos": "\\{review}DOS",
                "pc": "\\{review}PC",
                "pc_hardware": "\\{review}PC (Hardware)",
                "pc_software": "\\{review}PC (Software)",
                "ps1": "\\{review}PS1",
                "tombati": "\\{review}TombATI",
            }
        },
        "visuals.water_tint_mode": {
            "title": "\\{review}WasserfÃ¤rbung",
            "description": "\\{review}Wie viel von Lara die Wasserfarbe annimmt, wÃ¤hrend sie im Wasser ist. Ganz fÃ¤rbt sie vollstÃ¤ndig, wie in TR1 und TR2. Pro Mesh fÃ¤rbt jedes Mesh danach, wo es sitzt, wie in TR3 und TR4. Reaktiv schneidet sie an der WasseroberflÃ¤che, sodass nur der Teil unter Wasser die Farbe annimmt.",
        },
        "window.is_borderless": {
            "title": "\\{review}Randloser Vollbildmodus",
            "description": "\\{review}FÃ¼llt den Bildschirm mit einem Fenster ohne Rahmen, sodass andere Fenster und Overlays Ã¼ber dem Spiel bleiben kÃ¶nnen.",
        },
        "window.is_fullscreen": {
            "title": "\\{review}Vollbild",
            "description": "\\{review}FÃ¼llt den Bildschirm aus oder lÃ¤uft im Fenster.",
        }
    },
