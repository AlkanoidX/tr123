            "description": "\\{review}WÃ¤hlt die Paletten-Schattierung des ursprÃ¼nglichen PC-Software-Renderers oder PlayStation-RGB555-Dithering aus.",
        },
        "rendering.enable_affine_mapping": {
            "title": "\\{review}Affines Textur-Mapping",
            "description": "\\{review}LÃ¤sst die perspektivische Korrektur beim Texturieren weg, die der PlayStation fehlte, sodass Texturen auf groÃŸen FlÃ¤chen verzerren und wandern, wenn sich die Kamera bewegt.",
        },
        "rendering.enable_hall_of_mirrors": {
            "title": "\\{review}Spiegelsaal",
            "description": "\\{review}LÃ¤sst das vorherige Bild dort auf dem Bildschirm, wo nichts gezeichnet wird, wie in den PC-Versionen. Manche Level nutzen dies fÃ¼r Effekte, etwa in Thames Wharf. AuÃŸenbereiche ohne Skybox werden weiterhin geleert.",
        },
        "rendering.enable_palette_quantize": {
            "title": "\\{review}Paletten-Quantisierung",
            "description": "\\{review}Rastet jede gerenderte Farbe auf die nÃ¤chstgelegene Farbe der Levelpalette ein. Bei aktiviertem Dithering mischt die Palette zwischen ihren Farben.",
        },
        "rendering.enable_ps1_blending": {
            "title": "\\{review}PlayStation-Ãœberblendung",
            "description": "\\{review}Blendet einige Effekte und FlÃ¤chen wie auf der PlayStation mit der Szene. Rauch, Schatten und FuÃŸspuren ziehen ihre Farbe von der Szene ab, wodurch jeder Farbkanal um denselben Betrag abgedunkelt wird und das Ergebnis gesÃ¤ttigter wirkt. In TR1 und TR2 werden FlÃ¤chen wie WasseroberflÃ¤chen, Glas und MÃ¼ndungsfeuer sowie Effekte wie Spritzer, Flammen und Explosionen zur HÃ¤lfte mit der Szene gemischt. In TR3 wird auÃŸerdem Blut zur HÃ¤lfte mit der Szene gemischt. Deaktiviert wird all dies wie auf dem PC gezeichnet.",
        },
        "rendering.enable_ps1_fog": {
            "title": "\\{review}PlayStation-Nebel",
            "description": "\\{review}Blendet entfernte Geometrie so zur Nebelfarbe Ã¼ber, wie es die Tiefenabstufung der PlayStation tat: entlang 1/Entfernung statt der Entfernung und pro Vertex berechnet, sodass der Verlauf Ã¼ber groÃŸe FlÃ¤chen Stufen bildet.",
        },
        "rendering.enable_ps1_pixel_aspect": {
            "title": "\\{review}PlayStation-PixelseitenverhÃ¤ltnis",
            "description": "\\{review}Zeigt die Spielwelt schmaler, wie es die PlayStation auf einem Fernseher tat. Das Bild fÃ¼llt weiterhin den Bildschirm. Die OberflÃ¤che Ã¤ndert sich nicht.",
        },
        "rendering.enable_trapezoid_filter": {
            "title": "Trapezoid-Filter",
            "description": "Korrigiert das Rendern von Vierecken.",
        },
        "rendering.enable_vsync": {
            "title": "VSync",
            "description": "Schaltet V-Sync an oder aus.",
        },
        "rendering.fmv_filter": {
            "title": "\\{review}Videofilter",
            "description": "\\{review}Wechselt zwischen einem weichgezeichneten und einem pixeligen Aussehen der Videos.",
        },
        "rendering.fps": {
            "title": "FPS",
            "description": "Stellt Spiel-Frames pro second ein.",
        },
        "rendering.lighting_contrast": {
            "title": "Beleuchtungs-Kontrast",
            "description": "ErhÃ¶ht den Kontrast fÃ¼r dynamische Lichtquellen, wie zum Beispiel Fackeln und MÃ¼ndungsfeuer.",
        },
        "rendering.lighting_curve": {
            "title": "\\{review}Beleuchtungsmodell",
            "description": "\\{review}Legt fest, wie weit die Vertex-Beleuchtung die Textur skaliert.\n\n- Flach endet bei der Helligkeit der Textur selbst und wirkt dunkler (TR3 PC).\n- Overbright entspricht den PC-Renderern: ein voll beleuchteter Vertex hebt das Texel auf die doppelte Helligkeit, der Ãœberschuss wird danach addiert (TR4 PC).\n- SÃ¤ttigung ist die der PlayStation: sie verdoppelt das Texel ebenfalls, lÃ¤sst aber jede Farbe dort abschneiden, wo sie landet, sodass helle FlÃ¤chen ihre eigene Farbe behalten, statt ins WeiÃŸe auszubleichen (TR3/TR4 PS1).",
        },
        "rendering.multisampling_factor": {
            "title": "\\{review}Multisampling",
            "description": "\\{review}GlÃ¤ttet die Kanten von WÃ¤nden und Objekten, indem entlang dieser mehrere Abtastungen je Pixel genommen werden. Deutlich gÃ¼nstiger als Supersampling, lÃ¤sst aber die Kanten von Sprites wie Pflanzen und Feuer unberÃ¼hrt.",
        },
        "rendering.screenshot_format": {
            "title": "Bildschirmfoto-Format",
            "description": "Dateiformat des Bildschirmfotos.",
        },
        "rendering.sprite_lock_mode": {
            "title": "\\{review}Sprite-Sperrmodus",
            "description": "\\{review}Steuert, welche Achsen beim Anzeigen von Sprites auf dem Bildschirm gesperrt werden.\n\n- Keine: Sprites normal anzeigen.\n- Roll: Rollachse sperren â€“ nur im Fotomodus nÃ¼tzlich.\n- Roll & Neigung: Sicherstellen, dass die Sprites aufrecht stehen und nicht auf dem Boden liegen, wenn man sie von oben betrachtet.\n- Perspektive: Roll- und Neigungsachsen sperren und zusÃ¤tzlich die Sprites leicht zur Bildschirmmitte hin drehen.",
        },
        "rendering.supersampling_factor": {
            "title": "\\{review}Supersampling",
            "description": "\\{review}Rendert das Spiel mit einem Vielfachen seiner AuflÃ¶sung und mittelt es wieder herunter, was gezackte Kanten glÃ¤ttet. HÃ¶here Faktoren kosten die Grafikkarte ein Vielfaches an Arbeit.",
        },
        "rendering.texture_filter": {
            "title": "Textur-Filter",
            "description": "Wechselt zwischen weichgezeichneten und pixeligen Objekt-Texturen.",
        },
        "rendering.ui_filter": {
            "title": "UI-Filter",
            "description": "Schaltet zwischen weichgezeichneten und pixeligen UI-Texturen hin und her.",
        },
        "rendering.upscaling_factor": {
            "title": "Upsaling-Faktor",
            "description": "Skaliert das Spiel um einen festgelegten Wert hoch, erhÃ¤lt dabei die pixelige Optik.",
        },
        "rendering.upscaling_filter": {
            "title": "Upscaling-Filter",
            "description": "Schaltet zwischen weichgezeichneter oder pixeliger Optik fÃ¼r das gesamte Bild.",
        },
        "rendering.vertex_snap_mode": {
            "title": "\\{review}Vertex-Snapping",
            "description": "\\{review}Steuert das Vertex-Raster fÃ¼r die wackelige Geometrie der PlayStation-Versionen.\n\n- Deaktiviert: deaktiviert die Vertex-Rasterung.\n- 320x240: verwendet das ursprÃ¼ngliche 320x240-Raster.\n- Hochskalierte AuflÃ¶sung: verwendet die hochskalierte AuflÃ¶sung.",
        },
