        "audio.enable_ps1_sfx": {
            "title": "\\{review}PS1 SFX-Ersetzungen",
            "description": "\\{review}Aktiviert bestimmte Soundeffekt-Ersetzungen mit PS1-Ã„quivalenten.\n\n- Uzi-Feuer (nur TR1)\n- Hangeln (nur TR1)\n- Laras BarfuÃŸgerÃ¤usche (nur TR2)\n- Flammenwerfer- und Feuerkopf-Explosionen (nur TR3).",
        },
        "audio.enable_underwater_anim_sfx": {
            "title": "Tauch-Animations Sounds",
            "description": "Erlaubt Kontrolle Ã¼ber das Abspielen von bestimmten Animationen und Souneffekten - fÃ¼r Objekte, wie zum Beispiel TÃ¼ren und FalltÃ¼ren - wenn die Kamera unter Wasser ist.",
        },
        "audio.fix_chainblock_secret_sound": {
            "title": "Fix: Falsch abspielender Sound",
            "description": "\\{review}Verhindert, dass der Geheimnis-Ton inkorrekterweise abgespielt wird, wenn man den Goldenen SchlÃ¼ssel im Grab von Tihocan in TR1 benutzt.",
