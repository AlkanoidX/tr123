            "description": "\\{review}Erlaubt Lara, wÃ¤hrend des Rennens jederzeit zu springen. Das gibt es ab TR2; deaktiviert springt sie an den festen Punkten der Renn-Animation wie im originalen TR1.",
        },
        "gameplay.enable_tr2_swim_cancel": {
            "title": "Reaktionsschneller Schwimm-Abbruch",
            "description": "\\{review}Erlaubt Lara, unter Wasser schneller stoppen zu kÃ¶nnen, wenn die Springen-Taste losgelassen wird. Das gibt es ab TR2; deaktiviert stoppt sie wie im originalen TR1.",
        },
        "gameplay.enable_tr2_swimming": {
            "title": "FlÃ¼ssiges Schwimmverhalten",
            "description": "Verpasst Laras Drehgeschwindigkeit unter Wasser eine Beschleunigungskurve fÃ¼r ein runderes Steuerungsverhalten, Ã¤hnlich wie in TR2+.",
        },
        "gameplay.enable_underwater_auto_draw": {
            "title": "\\{review}Waffe unter Wasser ziehen",
            "description": "\\{review}LÃ¤sst die Taste zum Ziehen der Waffe zu einer Waffe greifen, die Lara unter Wasser benutzen kann, etwa der Harpune, statt nichts zu tun, wenn die zuletzt gehaltene Waffe dort nicht taugt.",
        },
        "gameplay.enable_uw_roll": {
            "title": "Rolle unter Wasser",
            "description": "\\{review}Erlaubt Lara, eine Rolle unter Wasser durchzufÃ¼hren, Ã¤hnlich wie in TR2+. Das originale TR1 hat keine Rolle unter Wasser.",
        },
        "gameplay.enable_wading": {
            "title": "Durchwaten",
            "description": "\\{review}Erlaubt Lara, flaches Wasser zu durchwaten, anstatt an der WasseroberflÃ¤che stecken zu bleiben. Das gibt es ab TR2; das originale TR1 kennt kein Waten.",
        },
        "gameplay.enable_walk_to_items": {
            "title": "Animierte Interaktionen",
            "description": "\\{review}LÃ¤sst Lara zu aufhebbaren GegenstÃ¤nden, Schaltern, SchlÃ¼ssellÃ¶chern und Puzzle-EinsÃ¤tzen gehen, wenn sie sich in der NÃ¤he befindet, anstatt sich dorthin zu teleportieren.",
        },
        "gameplay.enemy_health_scale": {
            "title": "\\{review}Gegnergesundheit",
            "description": "\\{review}Skaliert die Gesundheit, mit der Gegner beginnen. VerbÃ¼ndete sind nicht betroffen.",
        },
        "gameplay.fix_alligator_ai": {
            "title": "Fix: Alligator-AI",
            "description": "Fixt, dass die Alligatoren keinen Schaden machen, wenn Lara sich im Wasser befindet und sich nicht bewegt.",
        },
        "gameplay.fix_animated_spikes": {
            "title": "\\{review}Animierte Stacheln korrigieren",
            "description": "\\{review}Behebt ein Problem, bei dem aktivierte animierte Stacheln nach dem Laden eines Spielstands zurÃ¼ckgesetzt werden.",
        },
        "gameplay.fix_bear_ai": {
            "title": "Fix: BÃ¤ren-AI",
            "description": "Fixt, dass die aufrecht stehend ausgefÃ¼hrten Prankenhiebe von BÃ¤ren Lara nicht mehr verfehlen.",
        },
        "gameplay.fix_bird_start_pos": {
            "title": "\\{review}Vogelstart korrigieren",
            "description": "\\{review}Behebt, dass VÃ¶gel immer auf dem Boden unterhalb ihrer ursprÃ¼nglichen Position in der Luft starten.",
        },
        "gameplay.fix_breakable_wall_clip": {
            "title": "\\{review}Fix: Zerbrechliche WÃ¤nde durchqueren",
            "description": "\\{review}Fixt, dass Lara sich durch zerbrechliche WÃ¤nde am Rand eines Sektors hochziehen oder hindurchkriechen kann. Wenn aktiviert, hÃ¤lt sie vor der Wand an, bis diese zerstÃ¶rt ist.",
        },
        "gameplay.fix_bridge_collision": {
            "title": "Fix: BrÃ¼ckenkollision",
            "description": "Fixt, dass Lara nicht in der Lage ist, sich an einigen Teilen von BrÃ¼cken festzuhalten und unsichtbare WÃ¤nde an den Kanten. Fixt auch Kollisions-Fehler mit ZugbrÃ¼cken, FalltÃ¼ren, und BrÃ¼cken, wenn sie Ã¼bereinander gestapelt sind, Ã¼ber SchrÃ¤gen, und nahe dem Boden.",
        },
        "gameplay.fix_descending_glitch": {
            "title": "Fix: Zerbrechliche BÃ¶den-StÃ¼rze",
            "description": "\\{review}Fixt, dass Seit-Schritte und VorwÃ¤rtslaufen auf zerbrechlichen Platten dazu fÃ¼hren, dass Lara sofort herab zur darunter liegenden Platte fÃ¤llt. Die originalen TR2+ haben diesen Fehler nicht; TR1 schon.",
        },
        "gameplay.fix_enemy_route_delay": {
            "title": "\\{review}Gegner-RoutenverzÃ¶gerung beheben",
            "description": "\\{review}Behebt, dass Gegner bis zu mehrere Sekunden brauchen, um einen neuen Weg zu finden, nachdem Lara sich bewegt hat.",
        },
        "gameplay.fix_falling_glitch": {
            "title": "\\{review}Sturzfehler beheben",
            "description": "\\{review}Behebt Fehler, durch die Lara von FalltÃ¼ren springen kann, sobald sie sich Ã¶ffnen, anstatt hinunterzufallen, und durch die sie nicht hinunterfÃ¤llt, wenn der Boden unter ihr beim Drehen im Kriechen nachgibt.",
        },
        "gameplay.fix_flare_throw_priority": {
            "title": "Fix: Fackel-Wurf-PrioritÃ¤t",
            "description": "Fixt, dass Lara das Wegwerfen einer aufgebrauchten Fackel priorisiert, wÃ¤hrend sie sich in der Luft befindet. Dies kann manchmal dazu fÃ¼hren, dass sie nicht in der Lage ist, sich an Kanten festzuhalten.",
        },
        "gameplay.fix_floor_data_issues": {
            "title": "Fix: Floor-Data-Fehler",
            "description": "Fixt originale Fehler mit Boden Daten/Triggern.",
        },
        "gameplay.fix_free_flare_glitch": {
            "title": "Fix: gratis Fackel-Glitch",
            "description": "\\{review}Fixt die MÃ¶glichkeit, eine gratis Fackel zu erschaffen, wenn man wÃ¤hrend des Aufhebens eines Gegenstandes die Fackel-Taste drÃ¼ckt, oder indem sie wÃ¤hrend des Kriechens eine Ã¼ber das Inventar anfordert.",
        },
        "gameplay.fix_item_duplication_glitch": {
            "title": "Fix: Item-VervielfÃ¤ltigungs-Glitch",
            "description": "Fixt die MÃ¶glichkeit, SchlÃ¼sselgegenstÃ¤nde im Inventar mehrfach nutzen zu kÃ¶nnen.",
        },
        "gameplay.fix_lara_pickup_embed": {
            "title": "Fix: Pickup-Fehler",
            "description": "\\{review}Behebt, dass Lara beim Aufheben von GegenstÃ¤nden in Geometrie stecken bleibt. Wenn diese Option aktiviert ist, wird verhindert, dass Lara:\n\n- unter steilen, geneigten Decken eingeklemmt wird (wie im Original-TR1);\n- beim Aufheben von GegenstÃ¤nden unter Wasser in den Boden oder WÃ¤nde driftet (alle Spiele);\n- beim Aufheben von Fackeln unter Wasser in WÃ¤nde eindringt (TR2 PS1);\n- beim Aufheben einer Fackel in geduckter Haltung in WÃ¤nde eindringt (TR4+).",
        },
        "gameplay.fix_lift_collision": {
            "title": "Aufzug-Kollision beheben",
            "description": "\\{review}Behebt Fehler bei der Kollision mit beweglichen AufzÃ¼gen, durch die Lara stecken bleiben oder hindurchfallen kann.",
        },
        "gameplay.fix_m16_accuracy": {
            "title": "\\{review}Fix: M16/MP5-Genauigkeit im Laufen",
            "description": "\\{review}Behebt einen Fehler im Originalspiel, durch den das M16/MP5 beim SchieÃŸen im Laufen keinen Genauigkeitsabzug bekam. Mit dem Fix ist Feuer im Laufen ungenauer und richtet weniger Schaden an.",
        },
        "gameplay.fix_monkey_pickup_priority": {
            "title": "\\{review}Fix: Aufheben beim Hangeln",
            "description": "\\{review}Angegriffene Affen werden das ZurÃ¼ckschlagen priorisieren, bevor sie Medi-Packs und SchlÃ¼ssel aufsammeln.",
        },
        "gameplay.fix_pipeman_aim": {
            "title": "\\{review}Blasrohr-Zielen fixen",
            "description": "\\{review}Behebt ein Problem, bei dem der BlasrohrschÃ¼tze Lara manchmal nicht korrekt mit Pfeilen anvisieren kann.",
        },
        "gameplay.fix_qwop_glitch": {
            "title": "Fix: QWOP-Glitch",
            "description": "Fixt, dass Lara auf kleinen Stufen springt, was manchmal in einer seltsamen Lauf-Animation resultiert, bekannt als QWOP-Zustand.",
        },
        "gameplay.fix_step_glitch": {
            "title": "Fix: Stufen-Glitch",
            "description": "\\{review}Fixt, dass Lara manchmal in WÃ¤nde, die an Treppen angrenzen, gedrÃ¼ckt wird, wenn sie auf eine bestimmte Weise an ihnen entlanglÃ¤uft. Das originale TR1 hat diesen Fehler nicht; TR2 und TR3 schon.",
        },
        "gameplay.fix_underwater_crawl": {
            "title": "\\{review}Unterwasser-Kriechen korrigieren",
            "description": "\\{review}Behebt den Fehler, durch den Lara vom Land in Wasser- oder SumpfrÃ¤ume beliebiger Tiefe kriechen kann. Wenn aktiviert, kann Lara nur bis zu einer Tiefe von etwas mehr als einem Klick kriechen.",
        },
        "gameplay.fix_wade_sprint": {
            "title": "\\{review}Sprinten im seichten Wasser korrigieren",
            "description": "\\{review}Behebt einen Fehler, durch den Lara durch hÃ¼fttiefes Wasser sprinten kann, wenn sie laufend hineingeht.",
        },
        "gameplay.fix_wade_wall_hit": {
            "title": "Fix: Wand-Treffer beim Waten",
            "description": "Fixt, dass Lara beim waten nicht reagiert, wenn sie eine Wand trifft.",
