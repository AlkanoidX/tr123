        "input.touch_opacity": {
            "title": "OpacitÃ  comandi tattili",
            "description": "Regola il livello di trasparenza dei comandi tattili visualizzati sullo schermo.",
        },
        "language": {
            "title": "Lingua",
            "description": "Cambia la lingua dell'interfaccia utente.",
        },
        "rendering.anisotropy_filter": {
            "title": "Filtro anisotropico",
            "description": "Migliora il filtraggio delle texture a distanza.",
        },
        "rendering.aspect_mode": {
            "title": "Rapporto d'aspetto",
            "description": "Forza determinati rapporti d'aspetto del gioco con barre nere ai bordi.",
        },
        "rendering.borders": {
            "title": "Bordi",
            "description": "Aggiunge dei bordi neri attorno alla finestra del gioco.",
        },
        "rendering.dither_mode": {
            "title": "Retinatura",
            "description": "Seleziona la tavolozza dei colori della versione originale per PC con renderizzazione software (senza accelerazione 3D) o quella RGB555 della versione PlayStation.",
        },
        "rendering.enable_affine_mapping": {
            "title": "Mappatura texture affine",
            "description": "Elimina la correzione prospettica delle texture (caratteristica assente su PlayStation) facendo sÃ¬ che le texture si deformino e ondeggino sulle superfici quando la telecamera si muove.",
        },
        "rendering.enable_hall_of_mirrors": {
            "title": "Sala degli specchi",
            "description": "Riproduce l'errore grafico tipico delle versioni originali per PC in cui, nelle zone della mappa dove mancano texture o geometrie, il motore grafico ridisegna ripetutamente il fotogramma precedente. Alcuni livelli sfruttano questo aspetto per ottenere determinati effetti, come nel livello Molo sul Tamigi. Le aree esterne prive di cieli non vengono influenzate.",
        },
        "rendering.enable_palette_quantize": {
            "title": "Quantizzazione tavolozza",
            "description": "Adatta ogni colore renderizzato al colore piÃ¹ vicino della tavolozza del livello. Con la retinatura abilitata, i colori vengono adattati in base alla tavolozza disponibile.",
        },
        "rendering.enable_ps1_blending": {
            "title": "Fusione PlayStation",
            "description": "Fonde alcuni effetti e superfici con la scena, come avviene su PlayStation. Fumo, ombre e impronte sottraggono il proprio colore dalla scena, scurendo ogni canale cromatico in egual misura e producendo un risultato piÃ¹ saturo. In TR1 e TR2, elementi come superfici dell'acqua, vetro e lampi degli spari, ed effetti come schizzi, fiamme ed esplosioni, vengono miscelati con la scena in rapporto 50:50. In TR3, anche il sangue viene miscelato con la scena in rapporto 50:50. Se l'opzione Ã¨ disattivata, tutti questi elementi vengono renderizzati come nella versione per PC.",
        },
        "rendering.enable_ps1_fog": {
            "title": "Nebbia PlayStation",
            "description": "Fonde la geometria distante con il colore della nebbia seguendo la stessa logica degli indici di profonditÃ  della versione PlayStation: basandosi sul reciproco della distanza (1/distanza) anzichÃ© sulla distanza stessa, con il calcolo eseguito per singolo vertice, il che genera bande di sfumatura sulle superfici estese.",
        },
        "rendering.enable_ps1_pixel_aspect": {
            "title": "\\{review}Proporzioni dei pixel PlayStation",
            "description": "\\{review}Mostra il mondo di gioco piÃ¹ stretto, come faceva la PlayStation su un televisore. L'immagine riempie comunque lo schermo. L'interfaccia non cambia.",
        },
        "rendering.enable_trapezoid_filter": {
            "title": "Filtro trapezoidale",
            "description": "Corregge la renderizzazione dei quadrilateri.",
        },
        "rendering.enable_vsync": {
            "title": "Sincronizzazione verticale",
            "description": "Attiva o disattiva la sincronizzazione verticale.",
        },
        "rendering.fmv_filter": {
            "title": "Filtro FMV",
            "description": "Attiva o disattiva il filtro bilineare nei filmati.",
        },
        "rendering.fps": {
            "title": "FPS",
            "description": "Imposta i fotogrammi al secondo.",
        },
        "rendering.lighting_contrast": {
            "title": "Contrasto illuminazione",
            "description": "Aumenta il contrasto per fonti di luce dinamiche come razzi di segnalazione e lampi di armi da fuoco.",
        },
        "rendering.lighting_curve": {
            "title": "Modello illuminazione",
            "description": "Determina in che misura l'illuminazione dei vertici influisce sulla luminositÃ  della texture.\n\n- Piatto: si ferma alla luminositÃ  intrinseca della texture, risultando piÃ¹ scuro (TR3 PC).\n- Sovraesposto: riproduce il comportamento delle versioni PC; un vertice completamente illuminato raddoppia la luminositÃ  del texel, aggiungendo l'eccedenza in una fase successiva (TR4 PC).\n- Saturo: riproduce il comportamento della versione PlayStation; raddoppia anch'esso la luminositÃ  del texel, ma lascia che ogni componente di colore venga troncata al valore massimo raggiunto, preservando cosÃ¬ il colore originale delle superfici luminose invece di renderle sbiadite (TR3/TR4 PS1).",
        },
        "rendering.multisampling_factor": {
            "title": "Multicampionamento (MSAA)",
            "description": "Smussa i bordi di pareti e oggetti campionando piÃ¹ volte ciascun pixel lungo di essi. Impatta meno sulle prestazioni rispetto al supercampionamento, ma lascia intatti i bordi degli sprite come vegetazione e fuoco.",
        },
        "rendering.screenshot_format": {
            "title": "Formato cattura schermo",
            "description": "Formato del file da utilizzare per le istantanee dello schermo.",
        },
        "rendering.sprite_lock_mode": {
            "title": "ModalitÃ  blocco sprite",
            "description": "Controlla quali assi bloccare durante la visualizzazione degli sprite sullo schermo.\n\n- Nessuno: mostra gli sprite normalmente.\n- Rotazione: blocca l'asse di rotazione â€“ utile solo in modalitÃ  foto.\n- Rotazione e inclinazione: fa in modo che gli sprite rimangano in posizione verticale e non si inclinino verso il suolo quando li si guarda dall'alto.\n- Prospettiva: blocca gli assi di rotazione e inclinazione e, inoltre, ruota leggermente gli sprite verso il centro dello schermo.",
        },
        "rendering.supersampling_factor": {
            "title": "Supercampionamento (SSAA)",
            "description": "Renderizza il gioco a un multiplo della sua risoluzione e la riduce a quella desiderata, smussando i bordi frastagliati. I fattori piÃ¹ alti richiedono alla scheda grafica molta piÃ¹ potenza di calcolo.",
        },
        "rendering.texture_filter": {
            "title": "Filtro texture",
            "description": "Passa dalle texture di gioco filtrate a quelle pixelate e viceversa.",
        },
        "rendering.ui_filter": {
            "title": "Filtro interfaccia",
            "description": "Passa dall'interfaccia di gioco filtrata a quella pixelata e viceversa.",
        },
        "rendering.upscaling_factor": {
            "title": "Fattore di scala",
            "description": "Ridimensiona l'immagine di gioco in base a un fattore di scala definito, mantenendo un aspetto pixelato.",
        },
        "rendering.upscaling_filter": {
            "title": "Filtro ridimensionamento",
            "description": "Alterna l'aspetto smussato o pixelato per l'intero schermo.",
        },
        "rendering.vertex_snap_mode": {
            "title": "Aggancio Vertici",
            "description": "Controlla la griglia di aggancio dei vertici per emulare la geometria tremolante delle versioni PlayStation.\n\n- Disabilitato: disattiva l'aggancio dei vertici.\n- 320x240: utilizza la griglia originale 320x240.\n- Ridimensionato: utilizza la risoluzione ridimensionata.",
        },
        "ui.airbar_color": {
