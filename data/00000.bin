        "gameplay.game_modes_policy": {
            "title": "Selezione modalitÃ  di gioco",
            "description": "Consente di selezionare le modalitÃ  di gioco aggiuntive dal menu passaporto.\n\n- Nuova Partita+: sblocca tutte le armi con munizioni infinite; i nemici hanno punti vita doppi.\n\nOpzioni disponibili:\n\n- Sempre: la finestra di selezione delle modalitÃ  di gioco Ã¨ sempre disponibile.\n- Mai: la finestra di selezione delle modalitÃ  di gioco non Ã¨ disponibile e ogni nuova partita sarÃ  una partita normale.\n- Al completamento: la finestra di selezione delle modalitÃ  di gioco sarÃ  disponibile solo dopo aver completato il gioco.",
        },
        "gameplay.harpoon_recoil": {
            "title": "Ricarica fucile subacqueo",
            "description": "Imposta la frequenza con cui Lara deve ricaricare il fucile subacqueo, in base al numero attuale di munizioni. Ad esempio, se impostato a 3, dovrÃ  ricaricare dopo ogni terzo colpo. Impostare a 0 per disabilitare completamente la ricarica.",
        },
        "gameplay.idle_pose_timeout": {
            "title": "Tempo di inattivitÃ ",
            "description": "Permette a Lara di riprodurre la sua animazione di posa dopo il numero di secondi d'inattivitÃ  specificato. Impostalo a 0 per disabilitarlo.",
        },
        "gameplay.intro_fmv_mode": {
            "title": "Riproduzione FMV",
            "description": "Consente di specificare quando riprodurre il filmato introduttivo di ciascun gioco.\n\n- Nuova partita: il filmato viene riprodotto all'inizio di una nuova partita.\n- All'avvio: il filmato viene riprodotto ogni volta che il gioco viene avviato o si cambia gioco, come nelle versioni originali.",
        },
        "gameplay.jump_lock_mode": {
            "title": "ModalitÃ  blocco salto",
            "description": "Per salti piÃ¹ reattivi, consente di modificare quanto tempo deve attendere Lara per poter saltare dopo aver iniziato a correre.\n\n- Originale: corrisponde alla durata di tempo in TR2.\n- Modificato: Ã¨ possibile effettuare il salto 2 fotogrammi prima.\n- Disabilitato: Ã¨ possibile effettuare il salto subito dopo l'inizio della corsa.",
        },
        "gameplay.lara_damage_scale": {
            "title": "Danni subiti da Lara",
            "description": "Modifica l'entitÃ  dei danni subiti da Lara da qualsiasi fonte, come nemici, trappole e cadute.",
        },
        "gameplay.loading_screens": {
            "title": "Schermate di caricamento",
            "description": "Controlla il comportamento delle schermate di caricamento dei livelli.\n\n- Disabilitato: non mostra mai le schermate di caricamento.\n- Sempre: mostra le schermate di caricamento ogni volta che si avvia o carica un livello.\n- Nuovo livello: mostra le schermate di caricamento solo al primo avvio di un livello.",
        },
        "gameplay.look_mode": {
            "title": "ModalitÃ  osservazione",
            "description": "Permette di gestire in quali situazioni Lara puÃ² guardarsi attorno (tasto 'Guarda').\n\n- Limitato: Ã¨ consentito esaminare l'ambiente solo quando Lara Ã¨ ferma e mai quando Ã¨ sott'acqua, come nella versione originale di TR1.\n- Avanzato: Ã¨ consentito esaminare l'ambiente durante la maggior parte delle situazioni, tranne in alcune come quando si spingono i blocchi, come nella veriosne originale di TR2+.\n- Illimitato: Ã¨ sempre consentito esaminare l'ambiente durante il normale controllo di Lara.",
        },
        "gameplay.m16_aim_mode": {
            "title": "Varianti mira M16/MP5",
            "description": "Determina quando Lara mira con l'M16/MP5 dalla spalla anzichÃ© dal fianco.\n\n- Originale: Lara solleva l'arma alla spalla ogni volta che smette di muoversi.\n- Avanzato: Lara continua a sparare dal fianco finchÃ© viene premuto il tasto Azione e solleva l'arma alla spalla solo se inizia a sparare da ferma. Con la correzione della precisione in corsa attiva, sparare dal fianco comporta meno precisione e danni.",
        },
        "gameplay.maximum_quick_save_slots": {
            "title": "Slot di salvataggio rapido",
            "description": "Modifica il numero di slot di salvataggio rapido disponibili.",
        },
        "gameplay.maximum_save_slots": {
            "title": "Slot di salvataggio",
            "description": "Modifica il numero di slot di salvataggio disponibili.",
        },
        "gameplay.pause_on_focus_lost": {
            "title": "Pausa se in secondo piano",
            "description": "Mette in pausa la partita quando la finestra del gioco passa in secondo piano.",
        },
        "gameplay.projectile_area_damage": {
            "title": "Area danni proiettile",
            "description": "Controlla la propagazione dei danni del Lanciarazzi e del Lanciagranate.\n\n- Diffusione singola: comportamento di TR1 e TR2.\n- Diffusione multipla: comportamento di TR3.\n\nL'opzione \"Diffusione multipla\" spesso causa danni doppi ai singoli nemici.",
        },
        "gameplay.remember_gun_status": {
            "title": "Ricorda armi tra livelli",
            "description": "Fa sÃ¬ che Lara ricordi quale arma ha usato per ultima nel livello precedente quando inizia un nuovo livello. Se disabilitato, Lara tornerÃ  ad avere nella fondina le sue pistole.",
        },
        "gameplay.restore_ps1_enemies": {
            "title": "Ripristina nemici PS1",
            "description": "Aggiunge la mummia che appare nella versione PlayStation del livello 'CittÃ  di Khamoon' di TR1, stanza 25.\nLa modifica di questa opzione richiederÃ  il riavvio della partita.",
        },
        "gameplay.ring_memory_mode": {
            "title": "Ricorda posizione inventario",
            "description": "Apre il menu dell'inventario sull'oggetto selezionato in precedenza, invece che sul primo.\n\n- Disabilitato: apre il menu sul primo oggetto, come nel gioco originale.\n- Solo oggetti: viene salvata solo la posizione del menu degli oggetti.\n- Oggetti e chiavi: vengono salvate sia la posizione del menu degli oggetti che quella del menu delle chiavi.\n\nNei casi in cui Lara non possieda piÃ¹ l'oggetto selezionato nel menu oppure si inizi un nuovo livello, l'inventario tornerÃ  al primo oggetto del menu.",
        },
        "gameplay.save_crystal_mode": {
            "title": "ModalitÃ  cristalli",
            "description": "Determina il comportamento dei cristalli sparsi nei livelli.\n\n- Disabilitato: nessun cristallo presente nei livelli.\n- Salvataggio: i cristalli sono monouso e permettono a Lara di salvare la partita sul posto, come nella versione PS1 di TR1. Altrimenti Ã¨ possibile salvare solo alla fine dei livelli.\n- Salvataggio (oggetti): i cristalli possono essere raccolti e permettono a Lara di salvare la partita ovunque si trovi, come nella versione PS1 di TR3. Altrimenti Ã¨ possibile salvare solo alla fine dei livelli.\n- Curativi: i cristalli ripristinano metÃ  della salute di Lara e curano l'avvelenamento quando li tocca, come nella versione PC di TR3.\n- Oggetti: i cristalli sono oggetti collezionabili che vengono conteggiati nelle statistiche di livello e non hanno altre funzioni.\n\nLa modifica di questa opzione richiederÃ  il riavvio del livello.",
        },
        "gameplay.start_lara_hitpoints": {
            "title": "Salute iniziale di Lara",
            "description": "Imposta il valore di salute di Lara all'inizio di ogni livello.",
        },
        "gameplay.target_change_mode": {
            "title": "Cambio bersaglio",
            "description": "Modifica il modo in cui Lara passa da un bersaglio all'altro mentre mira con un'arma.\n\n- Disabilitato: Lara mantiene il bersaglio corrente.\n- Avanzato: premi il tasto Cambia Bersaglio per passare ad un altro bersaglio.\n- TR4: premi il tasto Guarda per passare ad un altro bersaglio; tenendolo premuto Lara puÃ² guardarsi attorno, dopo un breve ritardo.",
        },
        "gameplay.target_mode": {
            "title": "ModalitÃ  aggancio bersaglio",
            "description": "Modifica il comportamento di aggancio dei bersagli.\n\n- Completo: mantieni sempre il bersaglio agganciato anche se il nemico esce dal campo visivo o muore (TR1-3).\n- Parziale: mantieni il bersaglio agganciato anche se il nemico esce dal campo visivo, ma lo perdi se muore.\n- Nessuno: perdi il bersaglio agganciato se il nemico esce dal campo visivo o muore (TR4+).",
        },
        "gameplay.wall_glitch_mode": {
            "title": "ModalitÃ  errore pareti",
            "description": "Sceglie quali errori delle pareti Lara puÃ² sfruttare.\n\n- TR1: saltare in avanti contro una parete, teletrasporta Lara in cima ad essa, come nella versione originale di TR1.\n- TR2: l'errore del salto non Ã¨ piÃ¹ presente, ma Lara puÃ² ancora teletrasportarsi colpendo, in certe geometrie, il pavimento e la parete nello stesso momento, come nelle versioni originali di TR2 e TR3.\n- Corretto: entrambi gli errori sono stati corretti; Lara non puÃ² piÃ¹ oltrepassare i settori bloccati da porte.",
        },
        "input.enable_buffering_func_keys": {
            "title": "Buffering (tasti funzione)",
            "description": "Abilita il buffering dei tasti funzione (1 fotogramma) per ottenere un controllo preciso dei movimenti di Lara. Questa funzione esisteva originariamente solo nella versione TombATI (TR1).",
        },
        "input.enable_buffering_inventory": {
            "title": "Buffering (inventario)",
            "description": "Abilita il buffering dell'inventario (2 fotogrammi) per ottenere un controllo preciso dei movimenti di Lara.",
        },
        "input.enable_controller": {
            "title": "Supporto controller",
            "description": "Consente al gioco di individuare i controller collegati. Disattiva questa opzione se usi un software di rimappatura esterno che converte giÃ  il controller in input da tastiera.",
        },
        "input.enable_responsive_passport": {
            "title": "Passaporto reattivo",
            "description": "Fa in modo che sfogliare le pagine del passaporto sia piÃ¹ istantaneo, tenendo conto dei tasti premuti dell'utente",
        },
        "input.enable_touch_controls": {
            "title": "Comandi tattili",
            "description": "Mostra i comandi tattili per i dispositivi con schermo sensibile al tocco",
