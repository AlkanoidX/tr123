        "rendering.enable_ps1_blending": {
            "title": "Mezcla de PlayStation",
            "description": "Mezcla ciertos efectos y caras con la escena, como en PlayStation. El humo, las sombras y las huellas restan su color a la escena, oscureciendo todos los canales de color por igual y produciendo un resultado mÃ¡s saturado. En TR1 y TR2, las caras como las superficies de agua, el cristal y los destellos de disparos, asÃ­ como efectos como salpicaduras, llamas y explosiones, se mezclan al 50 % con la escena. En TR3, la sangre tambiÃ©n se mezcla al 50 %. Si se desactiva, todo esto se dibuja como en PC.",
        },
        "rendering.enable_ps1_fog": {
