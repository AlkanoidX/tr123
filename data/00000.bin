        "gameplay.fix_walk_run_jump": {
            "title": "Fix: Gehen-Laufen-Sprung",
            "description": "Fixt, dass Lara manchmal nicht sofort springen kann, direkt nachdem sie von ihrer Gehen-Animation zur Laufen-Animation wechselt.",
        },
        "gameplay.fix_wall_geometry": {
            "title": "\\{review}Behebt Wandgeometrie",
            "description": "\\{review}Behebt FÃ¤lle in der OG-Levelgeometrie, bei denen Neigungen innerhalb von WÃ¤nden zu ungenauen HÃ¶henberechnungen fÃ¼hren kÃ¶nnen. Die originalen TR3+ haben dieses Problem nicht; TR1 und TR2 schon.",
        },
        "gameplay.fix_water_exit": {
            "title": "Wasser Ausstieg",
            "description": "Fixt dass Lara direkt in einen angrenzenden, trockenen Raum oder in einen trockenen Raum unterhalb gelangen kann. ZusÃ¤tzlich verhindert es, dass Lara aus dem Wasser heraus auf nicht begehbare SchrÃ¤gen klettern kann.",
        },
        "gameplay.game_modes_policy": {
            "title": "Spielmodi-Auswahl",
            "description": "\\{review}Erlaubt die Auswahl der 'Neues Spiel Plus'-Optionen im 'Neues Spiel' Ausweis-MenÃ¼.\n\n- Neues Spiel+: schaltet alle Waffen mit unendlich Munition frei; Feinde haben verdoppelte Lebenserenergie.\n\nVerfÃ¼gbare Optionen:\n\n- Immer: Der Dialog zur Auswahl der Spielmodi ist immer verfÃ¼gbar.\n- Nie: Der Dialog zur Auswahl der Spielmodi ist nie verfÃ¼gbar, und jedes neue Spiel ist ein regulÃ¤res Spiel.\n- Nach Abschluss: Der Dialog zur Auswahl der Spielmodi ist erst verfÃ¼gbar, nachdem das Spiel abgeschlossen wurde.",
        },
        "gameplay.harpoon_recoil": {
            "title": "HarpunenrÃ¼ckstoÃŸ",
            "description": "Legt fest, wie oft Lara die Harpune nachladen muss, basierend auf ihrer momentanen Munitionsanzahl. Zum Beispiel, wenn es auf 3 festgelegt ist, muss sie nach jedem dritten Schuss nachladen. Auf 0 eingestellt, deaktiviert das Nachladen vollstÃ¤ndig.",
        },
        "gameplay.idle_pose_timeout": {
            "title": "\\{review}Leerlauf-Zeit",
            "description": "\\{review}ErmÃ¶glicht Lara, nach der angegebenen Anzahl an Sekunden InaktivitÃ¤t eine Posenanimation zu starten. Auf 0 setzen, um zu deaktivieren.",
        },
        "gameplay.intro_fmv_mode": {
            "title": "\\{review}Intro-FMV-Timing",
            "description": "\\{review}Steuert, wann der ErÃ¶ffnungsstory-FMV jedes Spiels abgespielt wird.\n\n- Neues Spiel: Wird beim Start eines neuen Spiels abgespielt.\n- Start: Wird jedes Mal abgespielt, wenn das Spiel gestartet oder gewechselt wird, wie bei den Originalspielen.",
        },
        "gameplay.jump_lock_mode": {
            "title": "Sprung-Block Modus",
            "description": "Erlaubt einzustellen, wie frÃ¼h es Lara erlaubt ist zu springen, nachdem sie begonnen hat zu laufen.\n\n- Original: entspricht dem originalen TR2 Timing.\n- Getuned: springen ist 2 Frames frÃ¼her mÃ¶glich.\n- Deaktiviert: springen ist sofort nachdem die Laufen-Animation begonnen hat mÃ¶glich.",
        },
        "gameplay.lara_damage_scale": {
            "title": "\\{review}Erlittener Schaden",
            "description": "\\{review}Skaliert den Schaden, den Lara aus jeder Quelle erleidet, etwa durch Gegner, Fallen und StÃ¼rze.",
        },
        "gameplay.loading_screens": {
            "title": "Ladebildschirme",
            "description": "\\{review}Steuert Ladebildschirme vor dem Laden eines Levels.\n\n- Deaktiviert: Ladebildschirme nie anzeigen.\n- Immer: Ladebildschirme anzeigen.\n- Neue Spiele: Ladebildschirme beim Laden eines Spielstands Ã¼berspringen.",
        },
        "gameplay.look_mode": {
            "title": "Umsehen Modus",
            "description": "\\{review}Erlaubt einzustellen wann Lara in der Lage ist sich umzusehen.\n\n- BeschrÃ¤nkt: Umsehen ist nur mÃ¶glich wenn Lara still steht, und nie wenn man unter Wasser ist.\n- Erweitert: Umsehen ist wÃ¤hrend der meisten Animationen mÃ¶glich, ausser ein paar Ausnahmen wie das Schieben eines Blockes.\n- UnbeschrÃ¤nkt: Umsehen ist jederzeit wÃ¤hrend der normalen Steuerung von Lara mÃ¶glich.\n\nBeschrÃ¤nkt entspricht dem originalen TR1, Erweitert dem originalen TR2+.",
        },
        "gameplay.m16_aim_mode": {
            "title": "\\{review}M16/MP5-Zielvarianten",
            "description": "\\{review}Steuert, wann Lara die M16/MP5 von der Schulter statt aus der HÃ¼fte anlegt.\n\n- Original: Lara nimmt die Waffe an die Schulter, sobald sie stehen bleibt.\n- Erweitert: Lara schieÃŸt weiter aus der HÃ¼fte, solange die Aktionstaste gehalten wird, und nimmt die Waffe nur an die Schulter, wenn sie im Stehen zu schieÃŸen beginnt. Mit aktivierter Korrektur der Laufgenauigkeit ist der HÃ¼ftschuss ungenauer und richtet pro Schuss weniger Schaden an.",
        },
        "gameplay.maximum_quick_save_slots": {
            "title": "\\{review}Anzahl der SchnellspeicherplÃ¤tze",
            "description": "\\{review}Ã„ndert die Anzahl der verfÃ¼gbaren SchnellspeicherplÃ¤tze.",
        },
        "gameplay.maximum_save_slots": {
            "title": "Anzahl der Speicher-Slots",
            "description": "Ã„ndert die Anzahl der verfÃ¼gbaren Speicher-Slots.",
        },
        "gameplay.pause_on_focus_lost": {
            "title": "\\{review}Pause bei Fokusverlust",
            "description": "\\{review}Stoppt den Spielfortschritt, wenn das Spiel-Fenster den Fokus verliert.",
        },
        "gameplay.projectile_area_damage": {
            "title": "\\{review}FlÃ¤chenschaden",
            "description": "\\{review}Steuert, wie der Wirkungsbereich fÃ¼r Raketenwerfer und Granatwerfer sich ausbreitet.\n\n- Einzelfeger: Verhalten von TR1 & TR2.\n- Mehrfachfeger: Verhalten von TR3.\n\nDie Mehrfachfeger-Option fÃ¼hrt oft zu doppeltem Schaden bei einzelnen Gegnern.",
        },
        "gameplay.remember_gun_status": {
            "title": "Waffen zwischen den Leveln merken",
            "description": "Bringt Lara dazu, sich zu erinnern, welche Waffe sie als Letztes im vorherigen Level verwendet hat, wenn ein neues Level beginnt. Bei Deaktivierung wird Lara auf geholsterte Pistolen zurÃ¼ckgreifen.",
        },
        "gameplay.restore_ps1_enemies": {
            "title": "PS1 Feinde wiederherstellen",
            "description": "\\{review}FÃ¼gt die Mumie hinzu, die in der PlayStation-Version von City of Khamoon in TR1, Raum 25, erscheint.\nDas Ã„ndern dieser Option erfordert einen Neustart des Spiels.",
        },
        "gameplay.ring_memory_mode": {
            "title": "\\{review}Inventar-Position merken",
            "description": "\\{review}Ã–ffnet einen Ring bei dem Eintrag, bei dem er verlassen wurde, statt beim ersten.\n\n- Aus: jedes Ã–ffnen beginnt beim ersten Eintrag, wie im Originalspiel.\n- Hauptring: nur der Gegenstandsring wird gemerkt.\n- Alle Ringe: der Gegenstands- und der SchlÃ¼sselring werden gemerkt.\n\nDer erste Eintrag kommt zurÃ¼ck, wenn Lara das Gemerkte nicht mehr trÃ¤gt, und jedes Level beginnt dort.",
        },
        "gameplay.save_crystal_mode": {
            "title": "\\{review}Kristallmodus",
            "description": "\\{review}Legt fest, was die in den Leveln verteilten Kristalle bewirken.\n\n- Aus: Es sind keine Kristalle vorhanden.\n- Speichern: Kristalle sind einmalig verwendbar und erlauben Lara, das Spiel an Ort und Stelle zu speichern, wie in der PS1-Fassung von TR1. Ansonsten kann nur am Ende eines Levels gespeichert werden.\n- Speichern (FundstÃ¼cke): Kristalle werden eingesammelt und erlauben Lara, das Spiel Ã¼berall aus dem Inventar heraus zu speichern, wie in der PS1-Fassung von TR3. Ansonsten kann nur am Ende eines Levels gespeichert werden.\n- Heilung: Kristalle stellen die HÃ¤lfte von Laras Gesundheit wieder her und heilen Vergiftungen, sobald sie sie berÃ¼hrt, wie in der PC-Version von TR3.\n- FundstÃ¼cke: Kristalle sind Sammelobjekte, die in der Levelstatistik gezÃ¤hlt werden, und bewirken sonst nichts.\n\nEine Ã„nderung dieser Option erfordert einen Neustart des Levels.",
        },
        "gameplay.start_lara_hitpoints": {
            "title": "\\{review}Laras Startenergie",
            "description": "Legt die HÃ¶he des Gesundheitswertes von Lara fÃ¼r den Start eines jeden Levels fest.",
        },
        "gameplay.target_change_mode": {
            "title": "Zielwechsel",
            "description": "\\{review}Ã„ndert, wie Lara beim Zielen zwischen Zielen wechselt.\n\n- Aus: Lara behÃ¤lt das aktuelle Ziel.\n- Erweitert: DrÃ¼cke die Zielwechsel-Taste, um zu wechseln.\n- TR4: Tippe die Umsehen-Taste an, um zu wechseln; hÃ¤ltst du sie gedrÃ¼ckt, sieht sie sich nach kurzer VerzÃ¶gerung um.",
        },
        "gameplay.target_mode": {
            "title": "\\{review}Zielmodus",
            "description": "Ã„ndert das automatische Anvisierungsverhalten von Laras Waffen gegenÃ¼ber Zielen.\n\n- Volles Lock-On: Das Ziel immer bleibt anvisiert, selbst wenn sich der Feind auÃŸer Sicht ist oder stirbt (OG TR1-3).\n- Halbes Lock-On: Das Ziel bleibt anvisiert wenn der Feind sich auÃŸer Sicht bewegt, lÃ¶st aber die Anvisierung sobald der Gegner stibt.\n- Kein Lock-On: LÃ¶se die Anvisierung sobald der Feind sich auÃŸer Sicht bewegt oder stibt (TR4+).",
        },
        "gameplay.wall_glitch_mode": {
            "title": "Wand-Glitch Ein/Aus",
            "description": "\\{review}Legt fest, welche Wand-Glitches Lara ausfÃ¼hren kann.\n\n- TR1: wie im originalen TR1, wo ein Sprung vorwÃ¤rts in eine Wand Lara nach oben auf sie versetzt.\n- TR2: wie im originalen TR2 und TR3, wo dieser Sprung nicht mehr funktioniert, Lara sich aber in bestimmter Geometrie noch versetzen kann, wenn sie Boden und Wand gleichzeitig trifft.\n- Gefixt: keiner der beiden Glitches funktioniert, und Lara kann den blockierten Sektor einer TÃ¼r nicht mehr passieren.",
        },
        "input.enable_buffering_func_keys": {
            "title": "\\{review}Pufferung (F-Tasten)",
            "description": "\\{review}Aktiviert F-Tasten (1-Frame) Pufferung, um eine prÃ¤zise Steuerung von Laras Bewegung zu ermÃ¶glichen. Diese Funktion existiert ursprÃ¼nglich nur im TombATI-Port (TR1).",
        },
        "input.enable_buffering_inventory": {
            "title": "\\{review}Pufferung (Inventar)",
            "description": "\\{review}Aktiviert die Pufferung des Inventars (2 Frames), um eine prÃ¤zise Steuerung von Laras Bewegung zu ermÃ¶glichen.",
        },
        "input.enable_controller": {
            "title": "\\{review}Controller-UnterstÃ¼tzung",
            "description": "\\{review}Erlaubt dem Spiel, angeschlossene Controller auszulesen. Deaktiviere dies, wenn du eine externe Remapping-Software verwendest, die deinen Controller bereits in Tastatureingaben Ã¼bersetzt.",
        },
        "input.enable_responsive_passport": {
            "title": "ReaktionsfÃ¤higer Ausweis",
            "description": "Deaktiviert, dass man die UmblÃ¤ttern-Animation des Ausweises abwarten muss, sie kÃ¶nnen nun so schnell umblÃ¤ttern, wie sie wollen.",
        },
        "input.enable_touch_controls": {
            "title": "\\{review}Touch-Steuerung",
            "description": "\\{review}Zeigt eine Bildschirm-Touch-Steuerung fÃ¼r Touchscreen-GerÃ¤te an.",
        },
        "input.enable_tr3_sidesteps": {
            "title": "Erweiterte Seit-Schritte",
            "description": "Aktiviert Seitschritte im Stil von TR3+, e. g. Shift + Richtungspfeile. Deaktiviert die Seitschritt-Tasten.",
        },
        "input.quick_guns_mode": {
            "title": "Schnell-Zieh-Tasten",
            "description": "Bestimmt das Verhalten der Schnell-Zieh-Tasten.\n\n- Nur ziehen: eine der Tasten zu drÃ¼cken sorgt dafÃ¼r, dass Lara die zugewiesene Waffe ausrÃ¼stet.\n- Ziehen oder wegstecken: das selbe wie bei 'Nur Ziehen', zusÃ¤tzlich wird Lara die zugewiesene Waffe, die sie gerade benutzt, wegstecken.",
        },
        "input.touch_button_scale": {
            "title": "\\{review}GrÃ¶ÃŸe der Touch-Tasten",
