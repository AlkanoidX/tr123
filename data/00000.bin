        "visuals.fog_start": {
            "title": "Inicio de la niebla",
            "description": "Establece la distancia en bloques donde la niebla comienza a aparecer. Los TR2 y TR3 originales comienzan a los 12 bloques. Un nivel puede incluir su propio valor, el cual se usarÃ¡ en su lugar.",
        },
        "visuals.fog_transparency": {
            "title": "Transparencia de la niebla",
            "description": "Determina si se activa la mezcla de la geometrÃ­a lejana en caras 100% transparentes.",
        },
        "visuals.fov": {
            "title": "Campo de visiÃ³n (FOV)",
            "description": "Ãngulo de visiÃ³n en grados. Los valores mÃ¡s grandes amplÃ­an el campo de visiÃ³n y los mÃ¡s pequeÃ±os lo reducen.",
        },
        "visuals.game_brightness": {
            "title": "Brillo del juego",
            "description": "Cambia el brillo del juego.",
        },
        "visuals.gamma": {
            "title": "Gamma",
            "description": "Ajusta la curva de gamma. Valores mÃ¡s altos significan una iluminaciÃ³n mÃ¡s brillante. El valor de 2.5 representa los colores predeterminados.",
        },
        "visuals.golden_lara": {
            "title": "Lara de oro",
            "description": "Convierte a Lara en oro, independientemente del atuendo que lleve puesto, tal como lo hace la mano de Midas.",
        },
        "visuals.lara_outfit": {
            "title": "Atuendo de Lara",
            "description": "Cambia la apariencia de Lara. Elegir Predeterminado respetarÃ¡ cualquier cambio de atuendo habitual entre niveles; de lo contrario, el valor elegido persistirÃ¡ hasta que se cambie manualmente.",
        },
        "visuals.level_start_transition": {
            "description": "CÃ³mo aparece un nivel al iniciarlo o cargar una partida. Fundido cruzado mezcla la pantalla de carga con el nivel. Fundido a negro desvanece la pantalla de carga hasta el negro y luego muestra el nivel desde el negro, como en el TR4 original. Sin pantalla de carga, ambos modos muestran el nivel mediante un fundido desde negro. Desactivado muestra el nivel de inmediato.",
            "title": "TransiciÃ³n al iniciar el nivel",
            "values": {
                "black": "Fundido a negro",
                "cross-fade": "Fundido cruzado",
                "disabled": "Desactivado",
            }
        },
        "visuals.logo_locale": {
            "description": "Determina cuÃ¡l de los logotipos del juego muestra la pantalla de tÃ­tulo. El original incluye uno para cada idioma en el que fue publicado.",
            "title": "Logotipo del tÃ­tulo",
            "values": {
                "de": "AlemÃ¡n",
                "en-gb": "InglÃ©s (Reino Unido)",
                "en-us": "InglÃ©s (EE. UU.)",
                "fr": "FrancÃ©s",
            }
        },
        "visuals.shadow_type": {
            "title": "Forma de las sombras",
            "description": "Selecciona cÃ³mo se renderizan las sombras de las entidades.\n\n- OctÃ³gono: sombras antiguas de TR1 y TR2\n- CÃ­rculo: sombras redondas\n- Sprite: sombras basadas en texturas de TR3",
        },
        "visuals.sunglasses_mode": {
            "title": "Gafas de sol de Lara",
            "description": "Cambia el estilo de las gafas de sol de Lara. Ten en cuenta que los cristales serÃ¡n reflectantes si la opciÃ³n correspondiente estÃ¡ activada.\n\n- Desactivado: Lara no llevarÃ¡ gafas de sol.\n- Opaco: las gafas de sol de Lara tendrÃ¡n cristales opacos.\n- Transparente: las gafas de sol de Lara tendrÃ¡n cristales semitransparentes.",
        },
        "visuals.sunglasses_reflective": {
            "title": "Gafas de sol reflectantes",
            "description": "Activa los reflejos en las lentes de las gafas de sol de Lara. TambiÃ©n deben estar activados los reflejos.",
        },
        "visuals.ui_brightness": {
            "title": "Brillo de la interfaz (UI)",
            "description": "Cambia el brillo de la interfaz de usuario.",
        },
        "visuals.water_color": {
            "title": "Color del agua",
            "description": "Color del agua.",
        },
        "visuals.water_color_mode": {
            "description": "Determina el tono subacuÃ¡tico de quÃ© versiÃ³n utilizar. Mientras se elija un ajuste predefinido, este mantendrÃ¡ el color del agua indicado abajo; Personalizado te deja ese color a tu elecciÃ³n.",
            "title": "Ajuste predefinido de color del agua",
            "values": {
                "custom": "Personalizado",
                "dos": "DOS",
                "pc": "PC",
                "pc_hardware": "PC (hardware)",
                "pc_software": "PC (software)",
                "ps1": "PS1",
                "tombati": "TombATI",
            }
        },
        "visuals.water_tint_mode": {
            "title": "Tinte del agua",
            "description": "Determina quÃ© parte de Lara se ve afectada por el color del agua mientras estÃ¡ en ella. Completo la tiÃ±e por entero, como hacen TR1 y TR2. Por malla tiÃ±e cada una de sus mallas segÃºn donde se sitÃºe, como hacen TR3 y TR4. Receptivo la corta en la superficie del agua, de modo que solo la parte que queda bajo el agua adopta el color.",
        },
        "window.is_borderless": {
            "title": "Pantalla completa sin bordes",
            "description": "Ocupa toda la pantalla con una ventana sin bordes, para que otras ventanas y superposiciones puedan permanecer por encima del juego.",
        },
        "window.is_fullscreen": {
            "title": "Pantalla completa",
            "description": "Llena la pantalla o se ejecuta en una ventana.",
        }
