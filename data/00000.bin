{
    // This file is used to enable the -l argument support.

    "engine": 2,
    "extends": "tr2",
    "name": "TR2 Direct Level",

    "savegame_file_fmt": "save_tr2_custom_%02d.dat",

    "enable_tr2_item_drops": true,
    "convert_dropped_guns": true,

    "sfx_path": "main.sfx",
    "injections": [
        "font.bin",
        "lara_animations.bin",
        "lara_guns.bin",
        "pda_model.bin",
        "controls_models.bin",
        "pickup_aid.bin",
        "winston_model.bin",
        "crystal.bin",
        "lara_extra.bin",
        "lara_rifle_sfx.bin",
        "secret_models_og.bin",
        "misc_sprites.bin",
        "lara_outfits.bin",
        "binoculars.bin",
    ],

    "levels": [
        {
            "path": "%direct_level%",
            "music_track": -1,
            "lara_outfit": "tr2_classic",
            "sequence": [
                {"type": "loop_game"},
                {"type": "level_stats"},
            ],
        },
    ],
}
