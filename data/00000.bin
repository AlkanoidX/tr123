        },
        "gameplay.target_mode": {
            "title": "Modo de fijaciÃ³n de armas",
            "description": "Cambia el comportamiento de cÃ³mo las armas fijan los objetivos.\n\n- FijaciÃ³n completa: mantiene siempre la fijaciÃ³n del objetivo incluso si el enemigo se pierde de vista o muere (TR1-3 original).\n- FijaciÃ³n parcial: mantiene la fijaciÃ³n si el enemigo se pierde de vista, pero la pierde si el enemigo muere.\n- Sin fijaciÃ³n: pierde la fijaciÃ³n si el enemigo se pierde de vista o muere (TR4+).",
        },
        "gameplay.wall_glitch_mode": {
            "title": "Modo de errores de muro",
            "description": "Elige quÃ© errores de muro (glitches) puede realizar Lara.\n\n- TR1: como en el TR1 original, lo que incluye saltar hacia adelante contra un muro y teletransportarse a la parte superior de este.\n- TR2: como en los TR2 y TR3 originales, donde ese salto ya no funciona, pero Lara aÃºn puede teletransportarse al golpear el suelo y el muro al mismo tiempo en ciertas geometrÃ­as.\n- Corregido: ninguno de los errores funciona y Lara ya no puede atravesar el sector bloqueado de una puerta.",
        },
        "input.enable_buffering_func_keys": {
