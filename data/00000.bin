        "audio.fix_sliding_sfx": {
            "title": "\\{review}Rutsch-SFX korrigieren",
            "description": "\\{review}Behebt, dass Laras Rutsch-SFX weiter abgespielt werden, obwohl sie sich nicht mehr in einem gÃ¼ltigen Rutschzustand befindet (TR3+-Stil). Wenn diese Option deaktiviert wird, werden die SFX unabhÃ¤ngig von Laras Zustand normal zu Ende abgespielt (TR1/2-Stil).",
        },
        "audio.fix_speeches_killing_music": {
