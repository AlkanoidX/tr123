{
    // For usage, refer to the documentation here:
    // https://lostartefacts.dev/trx/docs/stable/game_strings
    "extends": "en",
    "language_name": "English (British)",
    "general": {
        "settings": {
            "controls": {
                "customize": "Customise Controls",
            }
        },
        "stats": {
            "distance_travelled": "Distance Travelled",
        }
    },
    "dynamic": {
        "mods": {
            "tr3-la": {
                "title": "The Lost Artefact",
            }
        }
    },
    "enums": {
        "ui_element_location": {
            "bottom_center": "Bottom centre",
            "top_center": "Top centre",
        }
    },
    "settings": {
        "gameplay.enable_bouncy_grenades": {
            "description": "Enables TR3-style grenade behaviour: they ricochet off walls and slopes and produce a larger blast radius, but at the expense of reduced velocity.",
        },
        "gameplay.enable_enemy_rotation": {
            "title": "Randomise enemy start angle",
        },
        "gameplay.enable_swing_cancel": {
            "description": "Allows Lara's ledge-swinging animation to be cancelled by letting go and quickly grabbing again (TR2+ style). The original TR1 does not allow it.",
        },
        "gameplay.projectile_area_damage": {
            "description": "Controls how the area-of-effect for Rocket Launcher and Grenade Launcher propagates.\n\n- Single-sweep: TR1 & TR2 behaviour.\n- Multi-sweep: TR3 behaviour.\n\nThe multi-sweep option often ends up doing double damage to individual enemies.",
        },
        "gameplay.target_mode": {
            "description": "Changes the behaviour of how weapons lock onto targets.\n\n- Full lock: always keep target lock even if the enemy moves out of sight or dies (OG TR1-3).\n- Semi lock: keep target lock if the enemy moves out of sight but lose target lock if the enemy dies.\n- No lock: lose target lock if the enemy goes out of sight or dies (TR4+).",
        },
        "input.quick_guns_mode": {
            "description": "Controls the behaviour of the quick gun equip keys.\n\n- Draw only: pressing a key will cause Lara to equip the assigned gun.\n- Draw or holster: same as above, plus Lara will undraw the assigned gun if she's currently carrying it.",
        },
        "rendering.enable_palette_quantize": {
            "title": "Palette quantisation",
            "description": "Maps every rendered colour to the nearest colour in the level palette. With dithering on, the palette shades between its colours.",
        },
        "rendering.enable_ps1_blending": {
            "description": "Blends some effects and faces with the scene as the PlayStation did. Smoke, shadows and footprints subtract their colour from the scene, which darkens each colour channel by the same amount and gives a more saturated result. In TR1 and TR2, faces such as water surfaces, glass and gun flashes are mixed half and half with the scene. In TR3, blood is also mixed half and half with the scene. When disabled, all of these are drawn as on the PC.",
        },
        "rendering.enable_ps1_fog": {
            "description": "Blends distant geometry toward the fog colour the way the PlayStation depth cue did: along 1/distance rather than distance, and worked out per vertex, so the ramp bands across large surfaces.",
        },
        "rendering.lighting_curve": {
            "description": "Chooses how far vertex lighting scales the texture.\n\n- Flat stops at the texture's own brightness, which is dimmer (TR3 PC).\n- Overbright is what the PC renderers did: a fully lit vertex takes the texel to twice its brightness, with the excess added on afterwards (TR4 PC).\n- Saturate is the PlayStation's, doubling the texel as well but letting each colour clip where it lands, which keeps bright surfaces in their own colour instead of washing them out (TR3/TR4 PS1).",
        },
        "rendering.sprite_lock_mode": {
            "description": "Controls which axes to lock when showing sprites on the screen.\n\n- None: show the sprites normally.\n- Roll: lock the roll axis â€“ useful only in photo mode.\n- Roll & pitch: ensure the sprites stand upright and do not lie on the ground when looking at them from above.\n- Perspective: lock roll and pitch axes and additionally, rotate the sprites slightly towards the centre of the screen.",
        },
        "ui.airbar_color": {
            "title": "Airbar colour",
            "description": "Colour of the airbar.",
        },
        "ui.airbar_color_ps1": {
            "title": "Airbar colour",
            "description": "Colour of the airbar.",
        },
        "ui.bar_look": {
            "description": "Chooses the frame and colours the UI bars are drawn with, taken from one of the original releases. The choice also decides which set of bar colour settings below applies.",
        },
        "ui.enable_smooth_bars": {
            "description": "Makes the UI bars use smooth colour transitions.",
        },
        "ui.enemy_healthbar_color": {
            "title": "Enemy bar colour",
            "description": "Colour of the enemy healthbar.",
        },
        "ui.enemy_healthbar_color_allies": {
            "title": "Ally bar colour",
            "description": "Colour of the allies healthbar. Shown in the location of the enemy healthbars.",
        },
        "ui.enemy_healthbar_color_allies_ps1": {
            "title": "Ally bar colour",
            "description": "Colour of the allies healthbar. Shown in the location of the enemy healthbars.",
        },
        "ui.enemy_healthbar_color_ps1": {
            "title": "Enemy bar colour",
            "description": "Colour of the enemy healthbar.",
        },
        "ui.exposurebar_color": {
            "title": "Exposure bar colour",
            "description": "Colour of the cold water exposure bar.",
        },
        "ui.exposurebar_color_ps1": {
            "title": "Exposure bar colour",
            "description": "Colour of the cold water exposure bar.",
        },
        "ui.healthbar_color": {
            "title": "Healthbar colour",
            "description": "Colour of the healthbar.",
        },
        "ui.healthbar_color_ps1": {
            "title": "Healthbar colour",
            "description": "Colour of the healthbar.",
        },
        "ui.healthbar_poison_color": {
            "title": "Poison healthbar colour",
            "description": "Colour of the healthbar when Lara is poisoned.",
        },
        "ui.healthbar_poison_color_ps1": {
            "title": "Poison healthbar colour",
            "description": "Colour of the healthbar when Lara is poisoned.",
        },
        "ui.progressbar_color": {
            "title": "Loading bar colour",
            "description": "Colour of the loading bar.",
        },
        "ui.progressbar_color_ps1": {
            "title": "Loading bar colour",
            "description": "Colour of the loading bar.",
        },
        "ui.sprintbar_color": {
            "title": "Sprintbar colour",
            "description": "Colour of the sprintbar.",
        },
        "ui.sprintbar_color_ps1": {
            "title": "Sprintbar colour",
            "description": "Colour of the sprintbar.",
        },
        "ui.stats.show_distance_travelled": {
            "title": "Distance travelled",
            "description": "Shows the distance travelled row in the level statistics.",
        },
        "visuals.blood_effects": {
            "description": "Controls blood spark colours.\n\n- Disabled: no blood sparks are shown.\n- Pink: the default in German PC releases of TR3.\n- Red: the default in all other retail releases.",
        },
        "visuals.camera_mode": {
            "description": "Chooses which game's camera behaviour to use.\n\n- TR1: the chase camera follows the level's pathfinding boxes.\n- TR2: the same, with different chase and look limits, and different handling of fixed cameras.\n- TR3: the chase camera uses line of sight rather than the pathfinding boxes.\n- TR4: as TR3, and the camera also responds when an action moves Lara's view, such as picking up an item or shimmying around a corner.",
        },
        "visuals.fog_color": {
            "title": "Fog colour",
            "description": "Colour of the fog.",
        },
        "visuals.gamma": {
            "description": "Adjusts the gamma curve. Higher values mean brighter lighting. The value of 2.5 means default colours.",
        },
        "visuals.water_color": {
            "title": "Water colour",
            "description": "Colour of the water.",
        },
        "visuals.water_color_mode": {
            "title": "Water colour preset",
            "description": "Which release's underwater tint to use. While a preset is picked it holds the water colour below; Custom leaves that colour to you.",
        },
        "visuals.water_tint_mode": {
            "description": "How much of Lara the water colour takes while she is in water. Whole tints all of her, as TR1 and TR2 do. Per mesh tints each of her meshes by where it sits, as TR3 and TR4 do. Responsive cuts her at the water surface, so that only what lies under the water takes the colour.",
        }
    }
}
